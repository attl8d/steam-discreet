+    }
+    // Loopback IPC endpoints stay blocking: loopback_ipc.cc uses blocking reads and writes.
+    for (size_t i = 2; i < received && i < 4; ++i) {
+        if (endpoints[i] < 0 || fcntl(endpoints[i], F_SETFD, FD_CLOEXEC) < 0) valid = false;
     }
