 #endif
 
+#ifdef __APPLE__
+    serve_conn(std::move(conn));
+#else
     /**
      * The first frame is written from the connection's own thread: on Windows this runs inside the
      * CreateProcess hook, before the webhelper exists to read the pipe, so a patch list bigger than
      * the pipe buffer (~4 KB) would block the hook and Steam would never start (#947).
